generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// role: 'user' or 'admin'; admins are granted with `npm run admin:grant -- <email>`
/// points: rank points, 10 per task that has a doneAt; kept in step by POST /api/sync
/// timeZone: IANA name reported by the browser on each sync, used to turn a task's local date and time into
/// the moment its reminder is due
model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  role              String             @default("user")
  points            Int                @default(0)
  timeZone          String?
  createdAt         DateTime           @default(now())
  sessions          Session[]
  todos             Todo[]
  appliedOps        AppliedOp[]
  pushSubscriptions PushSubscription[]
}

/// One per browser that turned reminders on. locale: language for the notification text.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  locale    String   @default("en")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// purpose: 'register' or 'reset', so a code can only be used for the flow it was sent for
model EmailCode {
  email     String   @id
  purpose   String   @default("register")
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// key examples: 'login:ip:1.2.3.4', 'send-code:email:a@b.com'
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// status: '0' active, '1' done, '2' deleted
/// date: the day the task belongs to, 'YYYY-MM-DD' in the user's local time zone
/// location: optional free-text place, null when not set
/// time: optional 'HH:mm' on that day in the user's local time zone, null when not set
/// version: taken from a sequence on every insert and update (a trigger handles updates), so /api/sync can return
/// only the tasks that changed since the version a device last saw
/// remindedFor: the 'YYYY-MM-DD HH:mm' a reminder was last sent for, so moving the task's time re-arms it
model Todo {
  id        String    @id @default(uuid())
  userId    String
  content   String
  location  String?
  time      String?
  status    String    @default("0")
  date      String
  position  Int       @default(0)
  doneAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  version   BigInt   @default(autoincrement())
  remindedFor String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, version])
}

/// Sync operations already applied, so a request retried after a dropped response doesn't apply one twice.
/// Rows older than 30 days are cleared by /api/sync.
model AppliedOp {
  userId    String
  id        String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([createdAt])
}
