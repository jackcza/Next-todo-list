generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// role: 'user' or 'admin'; admins are granted with `npm run admin:grant -- <email>`
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  sessions     Session[]
  todos        Todo[]
}

/// purpose: 'register' or 'reset', so a code can only be used for the flow it was sent for
model EmailCode {
  email     String   @id
  purpose   String   @default("register")
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// key examples: 'login:ip:1.2.3.4', 'send-code:email:a@b.com'
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// status: '0' active, '1' done, '2' deleted
/// date: the day the task belongs to, 'YYYY-MM-DD' in the user's local time zone
model Todo {
  id        String    @id @default(uuid())
  userId    String
  content   String
  status    String    @default("0")
  date      String
  position  Int       @default(0)
  doneAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
